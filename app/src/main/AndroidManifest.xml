<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearningApp">
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UserWelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LessonActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        
        <!-- User Module Activities -->
        <activity
            android:name=".ui.UserLearningReasonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UserChoosePathActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UserRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UserLoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UserAllDoneActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UserDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.UserSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.StreakActivity"
            android:exported="false" />
        <activity
            android:name=".ui.game.DailyStreakActivity"
            android:exported="false" />
    </application>

</manifest>