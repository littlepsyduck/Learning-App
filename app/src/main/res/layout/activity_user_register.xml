<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white" android:padding="16dp"
    tools:context=".UserRegisterActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_arrow" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="66"
            android:progressDrawable="@drawable/custom_progress_bar" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_background_disabled"
        android:enabled="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="CONTINUE"
        android:textColor="#AFAFAF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/btnContinue"
        android:layout_marginTop="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/RegistrationLabel"
                android:text="Username của bạn?" />

            <RelativeLayout style="@style/InputContainer">
                <EditText
                    android:id="@+id/etUsername"
                    style="@style/RegistrationEditText"
                    android:hint="Username"
                    android:inputType="text" />
                <ImageView
                    android:id="@+id/iconUsernameError"
                    style="@style/RegistrationErrorIcon" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvUsernameError"
                style="@style/RegistrationErrorText"
                android:text="Username không hợp lệ!" />

            <TextView
                style="@style/RegistrationLabel"
                android:text="Password của bạn?" />
            <RelativeLayout style="@style/InputContainer">
                <EditText
                    android:id="@+id/etPassword"
                    style="@style/RegistrationEditText"
                    android:hint="Password"
                    android:inputType="textPassword" />
                <ImageView
                    android:id="@+id/iconPasswordError"
                    style="@style/RegistrationErrorIcon" />
            </RelativeLayout>
            <TextView
                android:id="@+id/tvPasswordError"
                style="@style/RegistrationErrorText"
                android:text="Password quá ngắn!" />

            <TextView
                style="@style/RegistrationLabel"
                android:text="Họ và tên của bạn?" />
            <RelativeLayout style="@style/InputContainer">
                <EditText
                    android:id="@+id/etFullName"
                    style="@style/RegistrationEditText"
                    android:hint="Họ và tên"
                    android:inputType="textPersonName" />
            </RelativeLayout>
            <TextView style="@style/RegistrationErrorText" />

            <TextView
                style="@style/RegistrationLabel"
                android:text="Tuổi của bạn?" />
            <RelativeLayout style="@style/InputContainer">
                <EditText
                    android:id="@+id/etAge"
                    style="@style/RegistrationEditText"
                    android:hint="Tuổi"
                    android:inputType="number" />
            </RelativeLayout>
            <TextView style="@style/RegistrationErrorText" />

            <TextView
                style="@style/RegistrationLabel"
                android:text="Địa chỉ Email của bạn là gì?" />
            <RelativeLayout style="@style/InputContainer">
                <EditText
                    android:id="@+id/etEmail"
                    style="@style/RegistrationEditText"
                    android:hint="Email"
                    android:inputType="textEmailAddress" />
                <ImageView
                    android:id="@+id/iconEmailError"
                    style="@style/RegistrationErrorIcon" />
            </RelativeLayout>
            <TextView
                android:id="@+id/tvEmailError"
                style="@style/RegistrationErrorText"
                android:text="Email không hợp lệ!" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>