<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <!-- Up Arrow Icon -->
    <ImageView
        android:id="@+id/ivArrowStart"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@android:drawable/arrow_up_float"
        app:layout_constraintBottom_toBottomOf="@+id/tvZoneTitle"
        app:layout_constraintEnd_toStartOf="@+id/tvZoneTitle"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvZoneTitle"
        app:tint="#58CC02" />

    <!-- Zone Title -->
    <TextView
        android:id="@+id/tvZoneTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROMOTION ZONE"
        android:textColor="#58CC02"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/ivArrowEnd"
        app:layout_constraintStart_toEndOf="@+id/ivArrowStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Up Arrow Icon (Right Side) -->
    <ImageView
        android:id="@+id/ivArrowEnd"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/arrow_up_float"
        app:layout_constraintBottom_toBottomOf="@+id/tvZoneTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvZoneTitle"
        app:layout_constraintTop_toTopOf="@+id/tvZoneTitle"
        app:tint="#58CC02" />

</androidx.constraintlayout.widget.ConstraintLayout>